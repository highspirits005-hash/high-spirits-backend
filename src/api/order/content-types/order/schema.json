{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Customer orders placed via the website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderId": {
      "type": "string",
      "unique": true,
      "configurable": false
    },
    "customerName": {
      "type": "string",
      "required": true,
      "minLength": 2
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email"
    },
    "address": {
      "type": "text"
    },
    "items": {
      "type": "json",
      "required": true
    },
    "totalAmount": {
      "type": "decimal",
      "required": true
    },
    "notes": {
      "type": "text"
    },
    "whatsappMessage": {
      "type": "text",
      "required": true
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Confirmed",
        "Preparing",
        "Ready",
        "Delivered",
        "Cancelled"
      ],
      "default": "Pending",
      "required": true
    },
    "source": {
      "type": "string",
      "default": "website"
    }
  }
}
